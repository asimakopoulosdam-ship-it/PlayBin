// Save this file as: api/anime-relations.js  (inside the "api" folder at your project root)
//
// Caches Jikan's anime relations (sequel/prequel links) in Vercel KV, effectively
// permanently — a franchise's relation structure essentially never changes once
// established. This is exactly the step that was causing incomplete merges (e.g.
// "My Hero Academia" only showing 3 of its 7 seasons): resolving which seasons
// belong together depends on walking this relations chain, and Jikan's relations
// endpoint is the single most rate-limited, flaky part of the whole stack. Once
// ANY user successfully resolves a franchise's chain, every future lookup for that
// same anime (by anyone, searching anytime) is instant with zero live calls.
//
// Query params: ?id=21   (the Jikan/MAL id)

async function getKv() {
  try {
    const mod = await import('@vercel/kv');
    return mod.kv;
  } catch (e) { return null; }
}

const CACHE_SECONDS = 60 * 60 * 24 * 365; // effectively permanent

async function fetchWithRetry(url, retries = 1, delayMs = 500) {
  for (let attempt = 0; attempt <= retries; attempt++) {
    try {
      const res = await fetch(url);
      if (res.ok) return res;
      if (attempt === retries) return res;
    } catch (e) {
      if (attempt === retries) throw e;
    }
    await new Promise(r => setTimeout(r, delayMs));
  }
}

export default async function handler(req, res) {
  const malId = req.query.id;
  if (!malId || !/^\d+$/.test(String(malId))) {
    return res.status(400).json({ error: 'Missing or invalid id' });
  }

  const cacheKey = `anime-relations:${malId}`;
  const kv = await getKv();

  if (kv) {
    try {
      const cached = await kv.get(cacheKey);
      if (cached) return res.status(200).json({ relations: cached, cached: true });
    } catch (e) { /* fall through to live */ }
  }

  let relations = [];
  try {
    const liveRes = await fetchWithRetry(`https://api.jikan.moe/v4/anime/${malId}/relations`, 1, 500);
    if (liveRes.ok) {
      const data = await liveRes.json();
      relations = data.data || [];
    }
  } catch (e) { /* relations stays [] */ }

  if (kv && relations.length > 0) {
    try { await kv.set(cacheKey, relations, { ex: CACHE_SECONDS }); } catch (e) { /* not fatal */ }
  }
  // An empty result is NOT cached — a 429/transient failure returning empty should
  // not permanently "freeze" this anime as having no relations.

  return res.status(200).json({ relations, cached: false });
}
