// Save this file as: api/anime-relations.js  (inside the "api" folder at your project root)
//
// Caches Jikan's anime relations (sequel/prequel links) in Vercel KV, effectively
// permanently — a franchise's relation structure essentially never changes once
// established. Resolving which seasons belong together depends on walking this
// relations chain, and Jikan's relations endpoint is the most rate-limited, flaky
// part of the whole stack. Once ANY user successfully resolves a franchise's chain,
// every future lookup for that same anime is instant with zero live calls.
//
// IMPORTANT (fix): a FAILED live lookup (429 / timeout / 5xx) now returns HTTP 502
// instead of "200 with an empty list". Before, the app couldn't tell "Jikan is
// rate-limiting us" apart from "this anime genuinely has no sequels", so it treated
// the failure as a real answer, never fell back, and the franchise chain stopped
// early (MHA at 3 of 7 seasons, Re:Zero stuck at 4 of 8, etc).
//
// Query params: ?id=21   (the Jikan/MAL id)

async function getKv() {
  try {
    const mod = await import('@vercel/kv');
    return mod.kv;
  } catch (e) { return null; }
}

const CACHE_SECONDS = 60 * 60 * 24 * 365; // effectively permanent
// A confirmed "no relations" (standalone anime) is cached for a shorter time — a
// sequel can still be announced later and needs to be picked up eventually.
const CACHE_SECONDS_EMPTY = 60 * 60 * 24 * 7;

async function fetchWithRetry(url, retries = 1, delayMs = 500, options) {
  for (let attempt = 0; attempt <= retries; attempt++) {
    try {
      const res = await fetch(url, options);
      if (res.ok) return res;
      if (attempt === retries) return res;
    } catch (e) {
      if (attempt === retries) throw e;
    }
    await new Promise(r => setTimeout(r, delayMs));
  }
}

export default async function handler(req, res) {
  const malId = req.query.id;
  if (!malId || !/^\d+$/.test(String(malId))) {
    return res.status(400).json({ error: 'Missing or invalid id' });
  }

  const cacheKey = `anime-relations:${malId}`;
  const kv = await getKv();

  if (kv) {
    try {
      const cached = await kv.get(cacheKey);
      // An empty array is a real cached answer ("no relations") and is truthy, so
      // this serves both cases correctly.
      if (Array.isArray(cached)) return res.status(200).json({ relations: cached, cached: true });
    } catch (e) { /* fall through to live */ }
  }

  let liveRes = null;
  try {
    liveRes = await fetchWithRetry(`https://api.jikan.moe/v4/anime/${malId}/relations`, 1, 500);
  } catch (e) { liveRes = null; }

  if (!liveRes || !liveRes.ok) {
    // Never cache a failure, and never disguise it as "no relations".
    return res.status(502).json({ error: 'Jikan relations unavailable right now' });
  }

  let relations;
  try {
    const data = await liveRes.json();
    relations = data.data || [];
  } catch (e) {
    return res.status(502).json({ error: 'Jikan relations returned an unreadable response' });
  }

  if (kv) {
    try {
      await kv.set(cacheKey, relations, { ex: relations.length > 0 ? CACHE_SECONDS : CACHE_SECONDS_EMPTY });
    } catch (e) { /* not fatal */ }
  }

  return res.status(200).json({ relations, cached: false });
}
