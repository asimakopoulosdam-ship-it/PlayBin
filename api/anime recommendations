// Save this file as: api/anime-recommendations.js  (inside the "api" folder at your project root)
//
// Caches anime recommendations (used for "You might also like") in Vercel KV for a
// long time — this data is community-submitted and barely ever changes for a given
// anime. Once resolved successfully for one user, every future lookup for the same
// anime is served instantly, with zero live calls.
//
// Tries Jikan (MyAnimeList) first, then falls back to AniList's own, separate
// recommendations if Jikan has none — smaller/newer anime often have no
// community-submitted recommendations on MAL at all yet (e.g. "Black Torch"),
// even though the show itself is findable fine. AniList's recommendations are a
// different, independently-submitted set, so this often fills the gap.
//
// Query params: ?id=21   (the Jikan/MAL id)

async function getKv() {
  try {
    const mod = await import('@vercel/kv');
    return mod.kv;
  } catch (e) { return null; }
}

const CACHE_SECONDS = 60 * 60 * 24 * 30; // 30 days — recommendations change rarely, but not never

async function fetchWithRetry(url, retries = 2, delayMs = 700, options) {
  for (let attempt = 0; attempt <= retries; attempt++) {
    try {
      const res = await fetch(url, options);
      if (res.ok) return res;
      if (attempt === retries) return res;
    } catch (e) {
      if (attempt === retries) throw e;
    }
    await new Promise(r => setTimeout(r, delayMs));
  }
}

async function recommendationsFromJikan(malId) {
  const res = await fetchWithRetry(`https://api.jikan.moe/v4/anime/${malId}/recommendations`);
  if (!res.ok) return [];
  const data = await res.json();
  return (data.data || []).slice(0, 8).map(r => ({
    externalId: `jikan-${r.entry.mal_id}`,
    title: r.entry.title,
    posterUrl: (r.entry.images && r.entry.images.jpg && r.entry.images.jpg.image_url) || null,
  }));
}

// AniList identifies a Media entry by its own MAL id directly (idMal), so this
// stays keyed the same way the rest of the app already resolves anime — no second
// id-mapping lookup needed.
async function recommendationsFromAniList(malId) {
  const query = `query ($idMal: Int) { Media(idMal: $idMal, type: ANIME) { recommendations(sort: RATING_DESC, perPage: 8) { nodes { mediaRecommendation { idMal title { romaji english } coverImage { large } } } } } }`;
  const res = await fetchWithRetry('https://graphql.anilist.co', 1, 500, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
    body: JSON.stringify({ query, variables: { idMal: Number(malId) } }),
  });
  if (!res.ok) return [];
  const data = await res.json();
  const nodes = (data.data && data.data.Media && data.data.Media.recommendations && data.data.Media.recommendations.nodes) || [];
  return nodes
    .map(n => n.mediaRecommendation)
    .filter(m => m && m.idMal)
    .map(m => ({
      externalId: `jikan-${m.idMal}`,
      title: m.title.english || m.title.romaji,
      posterUrl: (m.coverImage && m.coverImage.large) || null,
    }));
}

export default async function handler(req, res) {
  const malId = req.query.id;
  if (!malId || !/^\d+$/.test(String(malId))) {
    return res.status(400).json({ error: 'Missing or invalid id' });
  }

  const cacheKey = `anime-recommendations:${malId}`;
  const kv = await getKv();

  if (kv) {
    try {
      const cached = await kv.get(cacheKey);
      if (cached) return res.status(200).json({ results: cached, cached: true });
    } catch (e) { /* fall through to live */ }
  }

  let results = [];
  try {
    results = await recommendationsFromJikan(malId);
  } catch (e) { /* results stays [] */ }

  if (results.length === 0) {
    try {
      results = await recommendationsFromAniList(malId);
    } catch (e) { /* results stays [] */ }
  }

  if (kv) {
    try { await kv.set(cacheKey, results, { ex: CACHE_SECONDS }); } catch (e) { /* not fatal, even for an empty result — avoids hammering a title with genuinely no recommendations anywhere */ }
  }

  return res.status(200).json({ results, cached: false });
}
